# Copy to .env for local development. Never commit the real .env file.

# HTTP port the API listens on
PORT=3000

# PostgreSQL connection string. When empty the API uses in-memory storage.
# Matches the database started by `docker compose up -d db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks

# Same database, used by `npm run test:integration` (never point it at real data:
# the tests truncate the tasks table).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tasks_test

# Apply SQL migrations on boot (true/false). Useful on platforms without a release step.
AUTO_MIGRATE=false

# Commit that produced the running build; exposed by GET /health. Baked into the Docker image by CI.
GIT_SHA=local

# silent | error | info | debug
LOG_LEVEL=info

# --- CI/CD (set as GitHub secrets / variables, not in this file) ---
# RENDER_API_KEY, RENDER_SERVICE_ID, STAGING_URL, DISCORD_WEBHOOK_URL, CODECOV_TOKEN
